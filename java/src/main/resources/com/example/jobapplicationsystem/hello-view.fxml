<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="546.0" prefWidth="649.0" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="com.example.jobapplicationsystem.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <ListView fx:id="availableSkills" prefHeight="200.0" prefWidth="200.0" />
   <Slider fx:id="fontSizeSlider" max="30.0" min="10.0" value="14.0" />
   <ColorPicker fx:id="bgColorPicker" prefHeight="44.0" prefWidth="125.0" />
   <AnchorPane fx:id="mainPane" prefHeight="200.0" prefWidth="200.0" />
   <ImageView fx:id="profileImageView" fitHeight="100.0" fitWidth="150.0" pickOnBounds="true" preserveRatio="true" />
   <Button mnemonicParsing="false" onAction="#handleUploadCoverLetter" text="Upload Cover Letter" />
   <TextArea fx:id="coverLetterArea" prefHeight="200.0" prefWidth="200.0" wrapText="true" />
   <ListView fx:id="selectedSkills" prefHeight="200.0" prefWidth="200.0" />
   <TextField fx:id="txtFullName" />
   <TextField fx:id="txtAddress" />
   <TextField fx:id="txtPhone" />
   <TextField fx:id="birthDatePicker" />
   <RadioButton mnemonicParsing="false" text="RadioButton">
      <toggleGroup>
         <ToggleGroup fx:id="statusGroup" />
      </toggleGroup>
   </RadioButton>
   <Button mnemonicParsing="false" onAction="#handleUploadImage" text="Upload Image" />
   <Button mnemonicParsing="false" onAction="#handleSave" text="save" />
   <RadioButton mnemonicParsing="false" text="RadioButton" toggleGroup="$statusGroup" />
   <Button mnemonicParsing="false" onAction="#handleExit" text="Exit" />
   <RadioButton mnemonicParsing="false" text="RadioButton" toggleGroup="$statusGroup" />

    <Label fx:id="welcomeText" />
    <Button onAction="#onHelloButtonClick" text="Hello!" />
</VBox>
